#!/usr/bin/env bash
#ddev-generated
## Description: Check the ddev-zsh installation
## Usage: zsh-doctor

set -u

failed=0

echo "=== Binaries ==="

for command_name in zsh fzf starship git curl; do
  if command -v "$command_name" >/dev/null 2>&1; then
    printf 'OK      %-12s %s\n' \
      "$command_name" \
      "$(command -v "$command_name")"
  else
    printf 'MISSING %-12s\n' "$command_name"
    failed=1
  fi
done

echo
echo "=== Libraries ==="

libraries=(
  "antidote:/usr/local/share/antidote/antidote.zsh"
  "oh-my-zsh:/usr/local/share/oh-my-zsh/oh-my-zsh.sh"
)

for item in "${libraries[@]}"; do
  name="${item%%:*}"
  path="${item#*:}"

  if [ -r "$path" ]; then
    printf 'OK      %-12s %s\n' "$name" "$path"
  else
    printf 'MISSING %-12s %s\n' "$name" "$path"
    failed=1
  fi
done

echo
echo "=== Configuration ==="

for file in \
  "$HOME/.zshrc" \
  "$HOME/.zshrc.global" \
  "$HOME/.zshrc.project"
do
  if [ -r "$file" ]; then
    printf 'FOUND   %s\n' "$file"
  else
    printf 'OPTIONAL %s not present\n' "$file"
  fi
done

echo
echo "=== History ==="

if [ -d /mnt/ddev-zsh ] && [ -w /mnt/ddev-zsh ]; then
  printf 'OK      %s\n' "/mnt/ddev-zsh/.zsh_history"
else
  printf 'MISSING %s\n' "/mnt/ddev-zsh/.zsh_history"
  failed=1
fi

echo

if [ "$failed" -eq 0 ]; then
  echo "ddev-zsh appears to be configured correctly."
else
  echo "One or more ddev-zsh components are missing."
fi

exit "$failed"